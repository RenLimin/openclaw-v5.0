<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.model-scheduling</string>
    <key>Comment</key>
    <string>model-scheduling v1.1.0 — 启动时 source zshenv 加载 API key</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-c</string>
      <string>source ~/.zshenv 2>/dev/null; exec /opt/homebrew/bin/python3 /Users/bangcle/.openclaw/workspace/L2-infra/components/model-scheduling/scripts/proxy.py --host 127.0.0.1 --port 3000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/model-scheduling</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ExitTimeOut</key>
    <integer>10</integer>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/model-scheduling/logs/proxy.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/model-scheduling/logs/proxy.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/bangcle</string>
    </dict>
  </dict>
</plist>