#!/usr/bin/env bash
# git pre-commit hook: 自动重生成系统资产清单 + 提醒配置快照
# 安装: .git/hooks/pre-commit (本文件由 workspace 管理, 见 L2-infra/components/config/install-hooks.sh)
#
# 行为:
#   0. 明文凭据扫描 —— 命中即阻断 (安全红线, 最高优先)
#   1. 重生成资产清单, 有变化则自动加入本次提交
#   2. 检查 ~/.openclaw/openclaw.json 是否有未快照的变更, 仅提醒
#   3. 知识库 schema 校验 + INDEX.md 派生小节同步 (ADR-003 阶段 2)
#   4. 应答契约黄金基准 —— 仅当 prompts/ 下 spec/校验器/测试被改动时触发 (ADR-035 P1 §10)
#   1/2 不阻塞; 0/3/4 命中阻塞性错误时阻塞提交

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# --- 0. 明文凭据扫描 (安全红线; 命中即阻断, 先于一切自动 add) ---
SECRET_SCANNER="L2-infra/components/config/secret-scan/secret_scan.py"
if [ -f "$SECRET_SCANNER" ]; then
    if ! python3 "$SECRET_SCANNER"; then
        echo ""
        echo "❌ pre-commit 拦截: 暂存区疑似含明文凭据"
        echo "    凭据只能存 ~/.openclaw/secrets/ 或 Secret Store, 代码只读取。"
        echo "    确属误报: 在 secret_scan.py 规则中放行; 紧急可 --no-verify (事后必须补扫)。"
        exit 1
    fi
    echo "✅ 暂存区密钥扫描通过"
fi

# --- 1. 资产清单 ---
echo "🔄 正在重生成系统资产清单..."

if python3 L2-infra/components/config/gen_asset_inventory.py --check >/dev/null 2>&1; then
    echo "✅ 资产清单是最新的"
else
    python3 L2-infra/components/config/gen_asset_inventory.py
    git add docs/architecture/01-asset-inventory.md
    echo "✅ 资产清单已更新并加入本次提交"
fi

# --- 2. 配置快照 (见 docs/conventions/commit-and-config.md) ---
if [ -f L2-infra/components/config/snapshot_config.py ]; then
    if ! python3 L2-infra/components/config/snapshot_config.py --check >/dev/null 2>&1; then
        echo "⚠️  ~/.openclaw/openclaw.json 有未快照的变更"
        echo "    如本次提交涉及配置改动, 请运行:"
        echo "      python3 L2-infra/components/config/snapshot_config.py && git add config-snapshots/"
    else
        echo "✅ 配置快照是最新的"
    fi
fi

# --- 3. 知识库 schema 校验 + INDEX 派生同步 (ADR-003 阶段 2) ---
# 存在阻塞性错误时阻塞提交: 非法 layer/stage/category、重复 ID、缺 title。
# 这些会让三维查询静默漏数据 — 与 ADR-008 「静默失败比明确失败更危险」同理。
if [ -f L2-infra/components/memory-embedding/kb_index.py ] && [ -d docs/knowledge-base ]; then
    KB_OUT="$(mktemp -t kb_validate)"
    trap 'rm -f "$KB_OUT"' EXIT
    if python3 L2-infra/components/memory-embedding/kb_index.py --validate >"$KB_OUT" 2>&1; then
        echo "✅ 知识库 schema 校验通过"
        # INDEX.md 派生小节跟随内容变化, 自动重生并加入提交。
        # 不用 `|| true` 吐错: 它失败时 INDEX.md 会静默陈旧而 hook 报成功
        # (2026-08-23 第三轮 review 发现)。
        EMIT_OUT="$(mktemp -t kb_emit)"
        trap 'rm -f "$KB_OUT" "$EMIT_OUT"' EXIT
        if ! python3 L2-infra/components/memory-embedding/kb_index.py --emit-index >"$EMIT_OUT" 2>&1; then
            cat "$EMIT_OUT"
            echo ""
            echo "❌ INDEX.md 派生生成失败 — 不能静默放过"
            echo "    修完后重试, 或用 git commit --no-verify 跳过 (不推荐)"
            exit 1
        fi
        if ! git diff --quiet -- docs/knowledge-base/INDEX.md 2>/dev/null; then
            git add docs/knowledge-base/INDEX.md
            echo "✅ INDEX.md 派生小节已同步并加入本次提交"
        fi
    else
        cat "$KB_OUT"
        echo ""
        echo "❌ 知识库校验失败 — 存在阻塞性错误"
        echo "    修完后重试, 或用 git commit --no-verify 跳过 (不推荐)"
        exit 1
    fi
fi

# --- 4. 应答契约黄金基准 (ADR-035 P1 §10 eval 门禁) ---
# 仅当 P1/P2 spec、校验器或其测试在本次提交中被改动时触发，避免给无关提交加开销。
CONTRACT_SUITE="L2-infra/prompts/tests/run_tests.sh"
if [ -f "$CONTRACT_SUITE" ]; then
    if git diff --cached --name-only --diff-filter=ACMR | grep -qE "^L[234]-[a-z]+/prompts/"; then
        echo "🔄 应答契约/spec 有改动，运行黄金基准..."
        if ! bash "$CONTRACT_SUITE"; then
            echo ""
            echo "❌ pre-commit 拦截: 应答契约黄金基准失败"
            echo "    说明对 spec/校验器的改动让合规样例被误拦，或让违规样例被放行。"
            echo "    修完后重试，或 git commit --no-verify 跳过 (不推荐，门禁可能失效)。"
            exit 1
        fi
    fi
fi

exit 0
