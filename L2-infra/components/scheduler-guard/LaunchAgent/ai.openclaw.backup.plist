<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.backup</string>
    <key>Comment</key>
    <string>综合备份 — 每天 03:00 执行（2026-11-08 补齐调度落地）</string>
