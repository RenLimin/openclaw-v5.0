    <key>StandardErrorPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/context-management/logs/auto-recovery.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/bangcle</string>
    </dict>
  </dict>
