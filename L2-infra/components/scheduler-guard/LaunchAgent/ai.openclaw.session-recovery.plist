<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.session-recovery</string>
    <key>Comment</key>
    <string>会话失败自动重试 — 每 10min 检测主会话失败 + 未完成任务自动唤醒（2026-11-08 补齐调度落地）</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-c</string>
      <string>source ~/.zshenv 2>/dev/null; exec /opt/homebrew/bin/python3 /Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/scripts/check_and_retry.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery</string>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/logs/session-recovery.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/logs/session-recovery.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/bangcle</string>
    </dict>
  </dict>
</plist>
