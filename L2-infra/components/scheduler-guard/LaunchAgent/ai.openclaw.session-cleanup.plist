<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.openclaw.session-cleanup</string>
    <key>Comment</key>
    <string>会话清理 — 每天 02:00 清理过期子会话和已完成任务（2026-11-08 补齐调度落地）</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>-c</string>
      <string>source ~/.zshenv 2>/dev/null; exec /opt/homebrew/bin/python3 /Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/scripts/session_cleanup.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery</string>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>2</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/logs/session-cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bangcle/.openclaw/workspace/L2-infra/components/session-recovery/logs/session-cleanup.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/bangcle</string>
    </dict>
  </dict>
</plist>
