#!/usr/bin/env bash
# git pre-commit hook: 自动重生成系统资产清单 + 提醒配置快照
# 安装: .git/hooks/pre-commit (本文件由 workspace 管理, 见 scripts/install-hooks.sh)
#
# 行为:
#   1. 重生成资产清单, 有变化则自动加入本次提交
#   2. 检查 ~/.openclaw/openclaw.json 是否有未快照的变更, 仅提醒
#   3. 知识库 schema 校验 + INDEX.md 派生小节同步 (ADR-003 阶段 2)
#   1/2 不阻塞; 3 仅在有阻塞性错误时阻塞 (非法 layer/stage/重复 ID)

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# --- 1. 资产清单 ---
echo "🔄 正在重生成系统资产清单..."

if python3 scripts/gen_asset_inventory.py --check >/dev/null 2>&1; then
    echo "✅ 资产清单是最新的"
else
    python3 scripts/gen_asset_inventory.py
    git add docs/architecture/01-asset-inventory.md
    echo "✅ 资产清单已更新并加入本次提交"
fi

# --- 2. 配置快照 (见 docs/conventions/commit-and-config.md) ---
if [ -f scripts/snapshot_config.py ]; then
    if ! python3 scripts/snapshot_config.py --check >/dev/null 2>&1; then
        echo "⚠️  ~/.openclaw/openclaw.json 有未快照的变更"
        echo "    如本次提交涉及配置改动, 请运行:"
        echo "      python3 scripts/snapshot_config.py && git add config-snapshots/"
    else
        echo "✅ 配置快照是最新的"
    fi
fi

# --- 3. 知识库 schema 校验 + INDEX 派生同步 (ADR-003 阶段 2) ---
# 存在阻塞性错误时阻塞提交: 非法 layer/stage/category、重复 ID、缺 title。
# 这些会让三维查询静默漏数据 — 与 ADR-008 「静默失败比明确失败更危险」同理。
if [ -f scripts/kb_index.py ] && [ -d docs/knowledge-base ]; then
    if python3 scripts/kb_index.py --validate >/tmp/kb_validate.out 2>&1; then
        echo "✅ 知识库 schema 校验通过"
        # INDEX.md 派生小节跟随内容变化, 自动重生并加入提交
        python3 scripts/kb_index.py --emit-index >/dev/null 2>&1 || true
        if ! git diff --quiet -- docs/knowledge-base/INDEX.md 2>/dev/null; then
            git add docs/knowledge-base/INDEX.md
            echo "✅ INDEX.md 派生小节已同步并加入本次提交"
        fi
    else
        cat /tmp/kb_validate.out
        echo ""
        echo "❌ 知识库校验失败 — 存在阻塞性错误"
        echo "    修完后重试, 或用 git commit --no-verify 跳过 (不推荐)"
        exit 1
    fi
fi

exit 0
