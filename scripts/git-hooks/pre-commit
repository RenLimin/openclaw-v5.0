#!/usr/bin/env bash
# git pre-commit hook: 自动重生成系统资产清单
# 安装: .git/hooks/pre-commit (本文件由 workspace 管理, 见 scripts/install-hooks.sh)
#
# 行为:
#   1. 运行生成器
#   2. 如果有变化, 自动 git add 并加入本次提交
#   3. 不阻塞提交 (资产清单缺失不是阻塞理由, 只是提醒)

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "🔄 正在重生成系统资产清单..."

# 运行生成器 (stdout 模式, 不写文件, 只看是否有变化)
if python3 scripts/gen_asset_inventory.py --check >/dev/null 2>&1; then
    echo "✅ 资产清单是最新的"
    exit 0
fi

# 有变化 → 重生成
python3 scripts/gen_asset_inventory.py

# 加入本次提交
git add docs/architecture/01-asset-inventory.md

echo "✅ 资产清单已更新并加入本次提交"
exit 0
