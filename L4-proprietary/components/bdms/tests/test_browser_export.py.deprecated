"""Tests for browser automation export functionality.

Tests BrowserAdapter, OnesAdapter, OaAdapter, TimesheetAdapter
browser automation integration.
"""
from __future__ import annotations

import csv
import json
import os
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from unittest.mock import MagicMock, patch, PropertyMock

import pytest

# Skip all tests on non-darwin platforms (osascript only available on macOS)
pytestmark = pytest.mark.skipif(
    sys.platform != "darwin", reason="Browser automation tests only run on macOS"
)

_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT / "src") not in sys.path:
    sys.path.insert(0, str(_ROOT / "src"))

from bdms.modules.integration.adapters.browser_adapter import BrowserAdapter, ExportError
from bdms.modules.integration.adapters.ones_adapter import OnesAdapter, MissingSourceError as OnesMissingSourceError
from bdms.modules.integration.adapters.oa_adapter import OaAdapter, MissingSourceError as OaMissingSourceError
from bdms.modules.integration.adapters.timesheet_adapter import TimesheetAdapter, MissingSourceError as TimesheetMissingSourceError


# ─── BrowserAdapter Tests ───


class TestBrowserAdapter:
    """Test BrowserAdapter basic functionality."""

    def test_init_on_darwin(self):
        """BrowserAdapter initializes on macOS."""
        adapter = BrowserAdapter()
        assert adapter._timeout == 15

    def test_init_custom_timeout(self):
        """BrowserAdapter accepts custom timeout."""
        adapter = BrowserAdapter(timeout=60)
        assert adapter._timeout == 60

    def test_init_on_non_darwin_raises(self):
        """BrowserAdapter raises RuntimeError on non-macOS."""
        with patch.object(sys, "platform", "win32"):
            with pytest.raises(RuntimeError, match="仅支持 macOS"):
                BrowserAdapter()

    def test_is_available_on_darwin(self):
        """is_available returns True when osascript works."""
        adapter = BrowserAdapter()
        # May or may not pass depending on environment
        result = adapter.is_available()
        assert isinstance(result, bool)

    def test_is_available_when_osascript_missing(self):
        """is_available returns False when osascript not found."""
        adapter = BrowserAdapter()
        with patch("subprocess.run", side_effect=FileNotFoundError):
            assert adapter.is_available() is False

    def test_sanitize_js_removes_newlines(self):
        """_sanitize_js removes newlines from JS code."""
        adapter = BrowserAdapter()
        result = adapter._sanitize_js("var x = 1;\nvar y = 2;\r\nvar z = 3;")
        assert "\n" not in result
        assert "\r" not in result

    def test_sanitize_js_escapes_quotes(self):
        """_sanitize_js escapes double quotes."""
        adapter = BrowserAdapter()
        result = adapter._sanitize_js('document.querySelector(".class")')
        assert '\\"' in result

    def test_find_tab_calls_correct_applescript(self):
        """find_tab calls the right AppleScript for tab detection."""
        adapter = BrowserAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(
                returncode=0, stdout="https://ones.bangcle.com/page"
            )
            result = adapter.find_tab("ones.bangcle.com")
            assert result is True
            # Verify the AppleScript contains the URL
            cmd_args = mock_run.call_args[0][0]
            assert "ones.bangcle.com" in cmd_args[2]

    def test_execute_js_sends_correct_command(self):
        """execute_js builds correct osascript command."""
        adapter = BrowserAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(
                returncode=0, stdout="ok", stderr=""
            )
            adapter.execute_js("return 1", url_contains="ones.bangcle.com")
            cmd_args = mock_run.call_args[0][0]
            assert "osascript" in cmd_args
            assert "execute" in cmd_args[2]
            assert "javascript" in cmd_args[2]

    def test_execute_js_without_url(self):
        """execute_js works without url_contains."""
        adapter = BrowserAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(
                returncode=0, stdout="ok", stderr=""
            )
            adapter.execute_js("return 1")
            assert mock_run.called

    def test_execute_js_handles_timeout(self):
        """execute_js raises RuntimeError on timeout."""
        adapter = BrowserAdapter(timeout=1)
        with patch("subprocess.run", side_effect=subprocess.TimeoutExpired(cmd="", timeout=1)):
            with pytest.raises(RuntimeError, match="超时"):
                adapter.execute_js("return 1")

    def test_get_downloads_dir(self):
        """get_downloads_dir returns ~/Downloads."""
        adapter = BrowserAdapter()
        expected = Path.home() / "Downloads"
        assert adapter.get_downloads_dir() == expected

    def test_wait(self):
        """wait sleeps for specified seconds."""
        adapter = BrowserAdapter()
        start = time.time()
        adapter.wait(0.1)
        elapsed = time.time() - start
        assert elapsed >= 0.09

    def test_find_latest_file_empty_dir(self):
        """find_latest_file returns None for empty dir."""
        adapter = BrowserAdapter()
        with tempfile.TemporaryDirectory() as tmpdir:
            adapter._downloads_dir = Path(tmpdir)
            result = adapter.find_latest_file("*.csv")
            assert result is None

    def test_find_latest_file_finds_recent(self):
        """find_latest_file returns recent file."""
        adapter = BrowserAdapter()
        with tempfile.TemporaryDirectory() as tmpdir:
            tmpdir = Path(tmpdir)
            csv_file = tmpdir / "test.csv"
            csv_file.write_text("a,b,c\n1,2,3\n")
            adapter._downloads_dir = tmpdir
            result = adapter.find_latest_file("*.csv", max_age_seconds=60)
            assert result is not None
            assert result.name == "test.csv"

    def test_sanitize_js_removes_chinese(self):
        """_sanitize_js removes Chinese characters that break osascript."""
        adapter = BrowserAdapter()
        # Note: actual Chinese char removal happens in execute_js via AppleScript quoting
        result = adapter._sanitize_js('var x = "测试";')
        # The sanitize method currently only handles quotes and newlines
        # Chinese chars are handled by osascript itself (causes missing value)
        assert isinstance(result, str)


# ─── OnesAdapter Tests ───


class TestOnesAdapter:
    """Test OnesAdapter browser automation integration."""

    def test_init(self):
        """OnesAdapter initializes correctly."""
        adapter = OnesAdapter(timeout=30)
        assert adapter._timeout == 30

    def test_fetch_uses_file_path_when_provided(self, tmp_path):
        """fetch uses file_path directly when provided."""
        adapter = OnesAdapter()
        # Create temp CSV
        csv_file = tmp_path / "test.csv"
        csv_file.write_text("col1,col2\nval1,val2\n", encoding="utf-8-sig")
        result = adapter.fetch("sign", "202606", file_path=str(csv_file))
        assert len(result) == 1
        assert result[0]["col1"] == "val1"

    def test_fetch_uses_cache_when_available(self, tmp_path):
        """fetch reads from cache when CSV exists."""
        adapter = OnesAdapter()
        # Create cache CSV
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "202606周报-签约项目统计.csv"
        cache_file.write_text("col1,col2\nval1,val2\n", encoding="utf-8-sig")

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("sign", "202606")
            assert len(result) == 1

    def test_fetch_raises_when_no_source(self):
        """fetch raises MissingSourceError when no data available."""
        adapter = OnesAdapter()
        with patch("sys.platform", "linux"):
            with pytest.raises(OnesMissingSourceError):
                adapter.fetch("sign", "202606", use_cache=False)

    def test_read_csv(self, tmp_path):
        """_read_csv reads CSV correctly."""
        adapter = OnesAdapter()
        csv_file = tmp_path / "test.csv"
        csv_file.write_text("name,value\nfoo,bar\nbaz,qux\n", encoding="utf-8-sig")
        result = adapter._read_csv(csv_file)
        assert len(result) == 2
        assert result[0]["name"] == "foo"
        assert result[1]["value"] == "qux"

    def test_find_csv_returns_none_for_missing(self, tmp_path):
        """_find_csv returns None when file doesn't exist."""
        adapter = OnesAdapter()
        with patch.object(adapter, "_cache_dir", tmp_path):
            result = adapter._find_csv("sign", "202606")
            assert result is None

    def test_find_csv_returns_path_when_exists(self, tmp_path):
        """_find_csv returns path when file exists."""
        adapter = OnesAdapter()
        csv_file = tmp_path / "202606周报-签约项目统计.csv"
        csv_file.write_text("test", encoding="utf-8-sig")
        with patch.object(adapter, "_cache_dir", tmp_path):
            result = adapter._find_csv("sign", "202606")
            assert result is not None
            assert result.name == "202606周报-签约项目统计.csv"

    def test_export_from_browser_returns_none_on_non_darwin(self):
        """_export_from_browser returns None on non-macOS."""
        adapter = OnesAdapter()
        with patch("sys.platform", "linux"):
            result = adapter._export_from_browser("sign", "202606")
            assert result is None

    def test_export_from_browser_returns_none_on_error(self):
        """_export_from_browser returns None on exception."""
        adapter = OnesAdapter()
        with patch.object(adapter, "_check_chrome_available", side_effect=RuntimeError("Chrome not found")):
            result = adapter._export_from_browser("sign", "202606")
            assert result is None

    def test_check_chrome_available_raises_on_non_darwin(self):
        """_check_chrome_available raises on non-macOS."""
        adapter = OnesAdapter()
        with patch("sys.platform", "linux"):
            with pytest.raises(RuntimeError, match="仅支持 macOS"):
                adapter._check_chrome_available()

    def test_check_chrome_available_raises_when_osascript_fails(self):
        """_check_chrome_available raises when osascript fails."""
        adapter = OnesAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=1, stderr=b"error")
            with pytest.raises(RuntimeError, match="osascript 不可用"):
                adapter._check_chrome_available()

    def test_ensure_ones_tab_raises_when_not_open(self):
        """_ensure_ones_tab raises when ONES tab not found."""
        adapter = OnesAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=0, stdout="https://example.com")
            with pytest.raises(RuntimeError, match="ONES 标签页未打开"):
                adapter._ensure_ones_tab()

    def test_ensure_ones_tab_succeeds_when_open(self):
        """_ensure_ones_tab succeeds when ONES tab is open."""
        adapter = OnesAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(
                returncode=0, stdout="https://ones.bangcle.com/projects"
            )
            # Should not raise
            adapter._ensure_ones_tab()

    def test_run_ones_js_returns_missing_value_on_error(self):
        """_run_ones_js returns 'missing value' on error."""
        adapter = OnesAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=1, stderr=b"error", stdout="")
            result = adapter._run_ones_js("return 1")
            assert result == "missing value"

    def test_run_ones_js_returns_stdout_on_success(self):
        """_run_ones_js returns stdout on success."""
        adapter = OnesAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=0, stderr=b"", stdout="  ok  ")
            result = adapter._run_ones_js("return 1")
            assert result == "ok"


# ─── OaAdapter Tests ───


class TestOaAdapter:
    """Test OaAdapter browser automation integration."""

    def test_init(self):
        """OaAdapter initializes correctly."""
        adapter = OaAdapter(timeout=30)
        assert adapter._timeout == 30

    def test_fetch_uses_file_path_when_provided(self, tmp_path):
        """fetch uses file_path directly when provided."""
        adapter = OaAdapter()
        csv_file = tmp_path / "oa.csv"
        csv_file.write_text("合同编号,名称\nC001,测试\n", encoding="utf-8-sig")
        result = adapter.fetch("contract", "", file_path=str(csv_file))
        assert len(result) == 1
        assert result[0]["合同编号"] == "C001"

    def test_fetch_uses_cache_when_available(self, tmp_path):
        """fetch reads from cache when CSV exists."""
        adapter = OaAdapter()
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "oa_contracts.csv"
        cache_file.write_text("合同编号,名称\nC001,测试\n", encoding="utf-8-sig")

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("contract", "")
            assert len(result) == 1

    def test_fetch_raises_when_no_source(self):
        """fetch raises MissingSourceError when no data available."""
        adapter = OaAdapter()
        with tempfile.TemporaryDirectory() as tmpdir:
            with patch.object(adapter, "_cache_dir", Path(tmpdir)):
                with patch("sys.platform", "linux"):
                    with pytest.raises(OaMissingSourceError):
                        adapter.fetch("contract", "")

    def test_export_from_browser_returns_none_on_non_darwin(self):
        """_export_from_browser returns None on non-macOS."""
        adapter = OaAdapter()
        with patch("sys.platform", "linux"):
            result = adapter._export_from_browser("contract", "")
            assert result is None

    def test_ensure_oa_tab_raises_when_not_open(self):
        """_ensure_oa_tab raises when OA tab not found."""
        adapter = OaAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=0, stdout="https://example.com")
            with pytest.raises(RuntimeError, match="OA 标签页未打开"):
                adapter._ensure_oa_tab()

    def test_run_oa_js_returns_missing_value_on_error(self):
        """_run_oa_js returns 'missing value' on error."""
        adapter = OaAdapter()
        with patch("subprocess.run") as mock_run:
            mock_run.return_value = MagicMock(returncode=1, stderr=b"error", stdout="")
            result = adapter._run_oa_js("return 1")
            assert result == "missing value"


