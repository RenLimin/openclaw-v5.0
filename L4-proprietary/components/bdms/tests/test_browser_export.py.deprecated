class TestTimesheetAdapter:
    """Test TimesheetAdapter browser automation integration."""

    def test_init(self):
        """TimesheetAdapter initializes correctly."""
        adapter = TimesheetAdapter(timeout=30)
        assert adapter._timeout == 30

    def test_fetch_uses_file_path_when_provided(self, tmp_path):
        """fetch uses file_path directly when provided."""
        adapter = TimesheetAdapter()
        csv_file = tmp_path / "timesheet.csv"
        csv_file.write_text("person_id,hours\nP001,8\n", encoding="utf-8-sig")
        result = adapter.fetch("P001", "202606", file_path=str(csv_file))
