            result = adapter._run_timesheet_js("return 1")
            assert result == "missing value"


# ─── Integration Tests ───


class TestAdapterIntegration:
    """Integration tests for adapter chain."""

    def test_ones_adapter_full_chain_with_cache(self, tmp_path):
        """OnesAdapter full chain: cache → read → return."""
        adapter = OnesAdapter()
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "202606周报-签约项目统计.csv"
        cache_file.write_text(
            "BI履约ID,销售合同编号,合同名称\nB001,C001,测试项目\n",
            encoding="utf-8-sig"
        )

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("sign", "202606")
            assert len(result) == 1
            assert result[0]["BI履约ID"] == "B001"

    def test_ones_adapter_chain_file_over_cache(self, tmp_path):
        """OnesAdapter: file_path takes priority over cache."""
        adapter = OnesAdapter()
        # Create cache file
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "202606周报-签约项目统计.csv"
        cache_file.write_text("col1\ncache_val\n", encoding="utf-8-sig")
        # Create explicit file
        explicit_file = tmp_path / "explicit.csv"
        explicit_file.write_text("col1\nexplicit_val\n", encoding="utf-8-sig")

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("sign", "202606", file_path=str(explicit_file))
            assert result[0]["col1"] == "explicit_val"

    def test_oa_adapter_full_chain_with_cache(self, tmp_path):
        """OaAdapter full chain: cache → read → return."""
        adapter = OaAdapter()
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "oa_contracts.csv"
        cache_file.write_text(
            "合同编号,合同名称\nC001,测试合同\n",
            encoding="utf-8-sig"
        )

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("contract", "")
            assert len(result) == 1
            assert result[0]["合同编号"] == "C001"

    def test_timesheet_adapter_full_chain_with_cache(self, tmp_path):
        """TimesheetAdapter full chain: cache → read → return."""
        adapter = TimesheetAdapter()
        cache_dir = tmp_path / "ones_exports"
        cache_dir.mkdir(parents=True, exist_ok=True)
        cache_file = cache_dir / "timesheet.csv"
        cache_file.write_text(
            "person_id,work_date,hours\nP001,2026-06-01,8\n",
            encoding="utf-8-sig"
        )

        with patch.object(adapter, "_cache_dir", cache_dir):
            result = adapter.fetch("", "202606")
            assert len(result) == 1
            assert result[0]["person_id"] == "P001"
